# ============================================================
# KisanSarthi Backend — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename the copy to: .env
#   2. Fill in your real values from the Supabase dashboard.
#   3. NEVER commit .env to GitHub — it is listed in .gitignore.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# URL of your React frontend (used by CORS)
CLIENT_URL=http://localhost:5173

# ── Supabase ──────────────────────────────────────────────────
# Find all values at: Supabase Dashboard → Settings → API
#
# Your Supabase project URL (not a secret — safe to share)
SUPABASE_URL=https://your-project-id.supabase.co

# Publishable key (used by frontend and backend client)
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Service role key — BACKEND ONLY (bypasses RLS). NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Secret — used by authMiddleware to verify Supabase tokens
# Found at: Supabase Dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your_jwt_secret_here
