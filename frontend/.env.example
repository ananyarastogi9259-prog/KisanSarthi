# ============================================================
# KisanSarthi Frontend — Environment Variables Template
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file and rename it to: .env
#   2. Fill in your real values from Supabase dashboard.
#   3. NEVER commit .env to GitHub — it is listed in .gitignore.
# ============================================================

# —— Supabase (public — safe for frontend) ——————————————————
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# —— Backend API URL ————————————————————————————————————————
# Local development:
VITE_API_URL=http://localhost:5000/api
# Production (set this in Netlify dashboard instead):
# VITE_API_URL=https://your-render-backend.onrender.com/api

# —— AI Farming Assistant (optional) ——————————————————————
# Leave empty to use the built-in offline farming knowledge engine.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
